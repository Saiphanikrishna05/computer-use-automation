{
  "schemaVersion": "1.0.0",
  "id": "economics_measure",
  "version": 1,
  "title": "Look up a member's savings balance",
  "description": "Signs on to the Meridian Core Servicing Console, searches the Member Search panel by Member ID, and reads the member's name and the Current Balance of their Savings account from the Member Detail screen. Read-only: no records are created or modified.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "meridian",
      "product": "servicing-console",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "draft"
  },
  "maxRisk": "mutate_reversible",
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "The member number to look up in the Member Search panel",
      "required": true,
      "sensitivity": "none",
      "injected": false,
      "pattern": "^\\d{6}$",
      "example": "100004"
    }
  ],
  "outputs": [
    {
      "name": "savingsBalance",
      "type": "money",
      "description": "Current balance of the member's Savings account from the Accounts table",
      "required": true,
      "sensitivity": "financial",
      "extract": {
        "target": {
          "description": "cell \"$15,300.00\" in the Accounts panel",
          "framePath": [
            {
              "ordinal": 1,
              "name": "contentFrame",
              "urlPattern": "/console/content/search"
            }
          ],
          "candidates": [
            {
              "kind": "label",
              "text": "Savings",
              "positional": true,
              "expect": "cell",
              "column": "Current Balance"
            },
