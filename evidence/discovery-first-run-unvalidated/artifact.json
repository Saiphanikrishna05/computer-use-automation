{
  "schemaVersion": "1.0.0",
  "id": "lookup_member_savings_balance",
  "version": 1,
  "title": "Look up a member's savings balance",
  "description": "Signs on to the Meridian Core Servicing Console, searches the Member Search panel by Member ID, and reads the resulting Member Detail screen. Returns memberId, memberName, memberStatus and savingsBalance (the Current Balance of the Savings row in the Accounts table). Read-only: it performs no transactions and changes no records.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "meridian",
      "product": "servicing-console",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "draft"
  },
  "maxRisk": "mutate_reversible",
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "The credit union member number to look up.",
      "required": true,
      "sensitivity": "none",
      "injected": false,
      "pattern": "^\\d{6}$",
      "example": "100001"
