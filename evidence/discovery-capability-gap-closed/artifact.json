{
  "schemaVersion": "1.0.0",
  "id": "lookup_member_contact_details",
  "version": 1,
  "title": "Look Up Member Contact Details (E-Mail and Telephone)",
  "description": "Signs on to the Meridian Core Servicing Console, searches the Member Search panel by Member ID, and reads the member's contact details from the Member Profile panel on the Member Detail screen. Returns memberEmail (e-mail address) and memberPhone (telephone number). Read-only: performs a search and reads fields; changes no data and submits no transactions.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "meridian",
      "product": "servicing-console",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "draft"
  },
  "maxRisk": "mutate_reversible",
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "memberId",
      "type": "string",
      "description": "The member number to look up, as entered in the Member ID field of the Member Search panel.",
      "required": true,
      "sensitivity": "none",
      "injected": false,
      "pattern": "^\\d{6}$",
      "example": "100001"
    }
  ],
  "outputs": [
