<%- include('_head') %>

<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr><td><font face="Verdana, Arial" size="2" color="<%= tenant.accentColor %>"><b>Member Detail</b></font></td></tr>
</table>
<br>

<table border="1" cellpadding="0" cellspacing="0" bgcolor="#eceae4" width="640">
  <tr><td>
    <table border="0" cellpadding="5" cellspacing="0" width="100%">
      <tr bgcolor="<%= tenant.accentColor %>">
        <td colspan="4"><font face="Verdana, Arial" size="2" color="#ffffff"><b>Member Profile</b></font></td>
      </tr>
      <tr>
        <td width="120"><font face="Verdana, Arial" size="1">Member ID</font></td>
        <td width="200"><font face="Verdana, Arial" size="1"><b><%= member.id %></b></font></td>
        <td width="120"><font face="Verdana, Arial" size="1">Status</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.status %></font></td>
      </tr>
      <tr>
        <td><font face="Verdana, Arial" size="1">Name</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.name %></font></td>
        <td><font face="Verdana, Arial" size="1">Member Since</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.memberSince %></font></td>
      </tr>
      <tr>
        <td><font face="Verdana, Arial" size="1">Tax ID</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.ssn %></font></td>
        <td><font face="Verdana, Arial" size="1">Date of Birth</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.dateOfBirth %></font></td>
      </tr>
      <% if (member.memo) { %>
      <tr>
        <td><font face="Verdana, Arial" size="1">Account Memo</font></td>
        <td colspan="3"><font face="Verdana, Arial" size="1"><%= member.memo %></font></td>
      </tr>
      <% } %>
      <tr>
        <td><font face="Verdana, Arial" size="1">E-Mail</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.email %></font></td>
        <td><font face="Verdana, Arial" size="1">Telephone</font></td>
        <td><font face="Verdana, Arial" size="1"><%= member.phone %></font></td>
      </tr>
    </table>
  </td></tr>
</table>

<br>

<table border="1" cellpadding="0" cellspacing="0" bgcolor="#eceae4" width="640">
  <tr><td>
    <table border="0" cellpadding="5" cellspacing="0" width="100%">
      <tr bgcolor="<%= tenant.accentColor %>">
        <td colspan="4"><font face="Verdana, Arial" size="2" color="#ffffff"><b>Accounts</b></font></td>
      </tr>
      <% if (drifted) { %>
      <!--
        Post-upgrade layout. The columns have been re-ordered, a new "Status"
        column inserted, and the cells wrapped in <span>s by the new template
        engine. Nothing about the flow changed — but every positional selector
        pointing at this table is now wrong.
      -->
      <tr bgcolor="#c6cfd8">
        <td width="140"><font face="Verdana, Arial" size="1"><b>Account Type</b></font></td>
        <td width="130"><font face="Verdana, Arial" size="1"><b>Current Balance</b></font></td>
        <td width="90"><font face="Verdana, Arial" size="1"><b>Status</b></font></td>
        <td width="160"><font face="Verdana, Arial" size="1"><b>Account Number</b></font></td>
        <td><font face="Verdana, Arial" size="1"><b>Date Opened</b></font></td>
      </tr>
      <% member.accounts.forEach(function (acct) { %>
      <tr>
        <td><span><font face="Verdana, Arial" size="1"><%= acct.type %></font></span></td>
        <td><span><font face="Verdana, Arial" size="1"><b><%= formatMoney(acct.balance) %></b></font></span></td>
        <td><span><font face="Verdana, Arial" size="1">Open</font></span></td>
        <td><span><font face="Verdana, Arial" size="1"><%= acct.number %></font></span></td>
        <td><span><font face="Verdana, Arial" size="1"><%= acct.opened %></font></span></td>
      </tr>
      <% }); %>
      <% } else { %>
      <tr bgcolor="#b8c4d0">
        <td width="150"><font face="Verdana, Arial" size="1"><b>Account Type</b></font></td>
        <td width="170"><font face="Verdana, Arial" size="1"><b>Account Number</b></font></td>
        <td width="140"><font face="Verdana, Arial" size="1"><b>Current Balance</b></font></td>
        <td><font face="Verdana, Arial" size="1"><b>Date Opened</b></font></td>
      </tr>
      <% member.accounts.forEach(function (acct) { %>
      <tr>
        <td><font face="Verdana, Arial" size="1"><%= acct.type %></font></td>
        <td><font face="Verdana, Arial" size="1"><%= acct.number %></font></td>
        <td><font face="Verdana, Arial" size="1"><b><%= formatMoney(acct.balance) %></b></font></td>
        <td><font face="Verdana, Arial" size="1"><%= acct.opened %></font></td>
      </tr>
      <% }); %>
      <% } %>
    </table>
  </td></tr>
</table>

<br>
<table border="0" cellpadding="0" cellspacing="0">
  <tr>
    <td>
      <form method="get" action="/console/content">
        <input type="hidden" name="view" value="sub_account">
        <input type="hidden" name="id" value="<%= member.id %>">
        <input type="submit" name="open" id="ctl_<%= rid %>_o" value="Open Sub-Account">
      </form>
    </td>
    <td>&nbsp;</td>
    <td>
      <form method="get" action="/console/content">
        <input type="hidden" name="view" value="search">
        <input type="submit" name="back" id="ctl_<%= rid %>_b" value="Back to Search">
      </form>
    </td>
  </tr>
</table>

<% if (popupMessage) { %>
<script type="text/javascript">
  // Fires shortly after load rather than during it, so the navigation itself
  // completes and the dialog is a genuine mid-run interruption.
  setTimeout(function () { window.confirm(<%- JSON.stringify(popupMessage) %>); }, 350);
</script>
<% } %>

<%- include('_foot') %>
