<%- include('_head') %>

<table border="1" cellpadding="0" cellspacing="0" bgcolor="#eceae4" width="460">
  <tr><td>
    <table border="0" cellpadding="6" cellspacing="0" width="100%">
      <tr bgcolor="#8b6b1a">
        <td><font face="Verdana, Arial" size="2" color="#ffffff"><b>Inquiry Result</b></font></td>
      </tr>
      <tr>
        <td>
          <font face="Verdana, Arial" size="1">
            <b>No member record found for ID <%= memberId %>.</b><br><br>
            Verify the member number and re-submit. If the member was recently
