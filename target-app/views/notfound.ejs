          </font>
        </td>
      </tr>
      <tr>
        <td>
          <form method="get" action="/console/content">
            <input type="hidden" name="view" value="search">
            <input type="submit" name="back" id="ctl_<%= rid %>_r" value="Return to Search">
          </form>
        </td>
      </tr>
    </table>
  </td></tr>
</table>

<%- include('_foot') %>
