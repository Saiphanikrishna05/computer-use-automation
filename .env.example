# Required only for `npm run discover` and `npm run agent-demo` (the LLM paths).
# `npm run replay` never reads this — deterministic replay has no model in the loop.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
CUA_MODEL=claude-opus-5
CUA_EFFORT=high
CUA_HEADLESS=false
CUA_TARGET_PORT=4173
CUA_TENANT_B_PORT=4174
CUA_OPERATOR_PORT=7317
