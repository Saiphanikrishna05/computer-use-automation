{
  "schemaVersion": "1.0.0",
  "id": "mc_place_hold",
  "version": 1,
  "title": "Stage an Account Hold to the Confirmation Screen (no commit)",
  "description": "Signs on to Meridian Core, searches a member by member number, opens the member record, opens Place Account Hold, fills in the Share, Reason Code and Notes, and clicks Continue to reach the CONFIRM ACCOUNT HOLD review screen. It STOPS there and never clicks Apply Hold, so nothing is committed and the member's account is unchanged. Returns the share as shown on the review screen. Note: the confirmation screen itself is labelled IRREVERSIBLE ACTION - the caller must complete the hold manually if genuinely intended.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "cornerstone",
      "product": "meridian-core",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "approved",
    "approvedBy": "operator",
    "approvedAt": "2026-08-27T02:30:52.121Z",
    "note": "reviewed and approved for unattended replay"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Branch the operator signs on against. Injected by the runtime.",
      "required": true,
      "sensitivity": "none",
      "injected": true
    },
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number to search for",
      "required": true,
      "sensitivity": "none",
      "pattern": "^\\d{6}$",
      "example": "102777",
      "injected": false
    },
    {
      "name": "shareId",
      "type": "string",
      "description": "Share option label to place the hold on, e.g. 102777-MMKT-4",
      "required": true,
      "sensitivity": "none",
      "example": "102777-MMKT-4",
      "injected": false
    },
    {
      "name": "reasonCode",
      "type": "string",
      "description": "Hold reason code option label",
      "required": true,
      "sensitivity": "none",
      "example": "FRAUD - Suspected fraud",
      "injected": false
    },
    {
      "name": "notes",
      "type": "string",
      "description": "Free-text notes for the hold",
      "required": true,
      "sensitivity": "none",
      "example": "demo hold",
      "injected": false
    }
  ],
