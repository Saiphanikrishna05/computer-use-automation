{
  "schemaVersion": "1.0.0",
  "id": "mc_open_share",
  "version": 1,
  "title": "Stage a New Share Opening to the Confirmation Screen",
  "description": "Signs on to Meridian Core, searches for a member by member number, opens the member record, starts Open New Share, sets the share type and initial deposit, and clicks Continue to reach the CONFIRM NEW SHARE review screen. It STOPS at confirmation and never clicks \"Open Share\", so no account is created and nothing is committed. Returns the member name, staged share type and staged initial deposit as displayed on the confirmation screen.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "cornerstone",
      "product": "meridian-core",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "approved",
    "approvedBy": "operator",
    "approvedAt": "2026-08-27T02:48:41.814Z",
    "note": "reviewed and approved for unattended replay"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Branch the operator signs on against. Injected by the runtime.",
      "required": true,
      "sensitivity": "none",
      "injected": true
