    "surface": "web",
    "app": {
      "vendor": "cornerstone",
      "product": "meridian-core",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "approved",
    "approvedBy": "operator",
    "approvedAt": "2026-08-27T02:45:58.922Z",
    "note": "reviewed and approved for unattended replay"
  },
