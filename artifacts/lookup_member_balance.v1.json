{
  "schemaVersion": "1.0.0",
  "id": "lookup_member_balance",
  "version": 1,
  "title": "Look up a member's savings balance",
  "description": "Signs on to the servicing console, searches for a member by ID, opens their profile and returns the member's name plus the current balance and account number of their savings account. Read-only: makes no change to any account.",
  "target": {
    "surface": "web",
    "app": { "vendor": "meridian", "product": "servicing-console", "versionRange": "1.x" },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": { "state": "approved", "approvedBy": "seed", "approvedAt": "2026-08-13T00:00:00.000Z", "note": "Hand-authored reference artifact used to develop and test the replay engine." },
  "maxRisk": "mutate_reversible",

  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "description": "Six-digit member number to look up.",
      "required": true,
      "sensitivity": "none",
      "pattern": "^\\d{6}$",
      "example": "100001"
    },
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    }
  ],

  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "Full name on the member record.",
      "required": true,
      "sensitivity": "pii",
      "extract": {
        "source": "text",
        "transforms": ["collapse_whitespace"],
        "target": {
          "description": "Name value cell in the member profile panel",
          "framePath": [{ "name": "contentFrame" }],
          "ordinal": 0,
          "anchor": { "containerName": "Member Profile" },
          "candidates": [{ "kind": "label", "text": "Name", "expect": "cell", "positional": true }]
        }
      }
    },
    {
      "name": "savingsBalance",
      "type": "money",
      "description": "Current balance of the member's savings account, in dollars.",
      "required": true,
      "sensitivity": "financial",
      "extract": {
        "source": "text",
        "transforms": ["collapse_whitespace", "money"],
        "target": {
          "description": "Current Balance cell of the Savings row in the Accounts panel",
          "framePath": [{ "name": "contentFrame" }],
          "anchor": { "containerName": "Accounts" },
          "candidates": [
            { "kind": "label", "text": "Savings", "expect": "cell", "column": "Current Balance", "positional": true }
          ]
        }
      }
    },
    {
      "name": "savingsAccountNumber",
      "type": "string",
      "description": "Account number of the member's savings account.",
      "required": true,
      "sensitivity": "financial",
      "extract": {
        "source": "text",
        "transforms": ["collapse_whitespace"],
        "target": {
          "description": "Account Number cell of the Savings row in the Accounts panel",
          "framePath": [{ "name": "contentFrame" }],
          "anchor": { "containerName": "Accounts" },
          "candidates": [
            { "kind": "label", "text": "Savings", "expect": "cell", "column": "Account Number", "positional": true }
          ]
        }
      }
    }
  ],

  "steps": [
    {
      "id": "enter_operator_id",
      "intent": "Type the operator user ID into the sign-on form",
      "risk": "mutate_reversible",
      "action": {
        "kind": "type",
        "valueTemplate": "{{operatorId}}",
        "clearFirst": true,
        "target": {
          "description": "User ID field on the sign-on screen",
          "framePath": [],
          "anchor": { "containerName": "Operator Sign-On" },
          "candidates": [
            { "kind": "label", "text": "User ID", "positional": true, "expect": "control" },
            { "kind": "structural", "css": "input[name='username']" }
          ],
          "evidence": { "role": "textbox", "tag": "input" }
        }
      }
    },
    {
      "id": "enter_operator_password",
      "intent": "Type the operator password into the sign-on form",
      "risk": "mutate_reversible",
      "action": {
        "kind": "type",
        "valueTemplate": "{{operatorPassword}}",
        "clearFirst": true,
        "secret": true,
        "target": {
          "description": "Password field on the sign-on screen",
          "framePath": [],
          "anchor": { "containerName": "Operator Sign-On" },
          "candidates": [
            { "kind": "label", "text": "Password", "positional": true, "expect": "control" },
            { "kind": "structural", "css": "input[type='password']" }
          ],
          "evidence": { "role": "textbox", "tag": "input" }
        }
      }
    },
    {
      "id": "submit_signon",
      "intent": "Submit the sign-on form to reach the servicing console",
      "risk": "mutate_reversible",
      "action": {
        "kind": "click",
        "target": {
          "description": "Sign On button",
          "framePath": [],
          "candidates": [
            { "kind": "role_name", "role": "button", "name": "Sign On", "exact": true },
            { "kind": "structural", "css": "input[type='submit']" }
          ],
          "evidence": { "role": "button", "tag": "input", "accessibleName": "Sign On" }
        }
      }
    },
    {
      "id": "await_search_screen",
      "intent": "Wait for the member search screen to load in the content frame",
      "risk": "read",
      "action": {
        "kind": "wait_for",
        "timeoutMs": 15000,
        "condition": {
          "kind": "text_present",
          "text": "Member Search",
          "framePath": [{ "name": "contentFrame" }]
        }
      }
    },
    {
      "id": "enter_member_id",
      "intent": "Type the member number into the Member Search panel",
      "risk": "mutate_reversible",
      "action": {
        "kind": "type",
        "valueTemplate": "{{memberId}}",
        "clearFirst": true,
        "target": {
          "description": "Member ID field in the Member Search panel",
          "framePath": [{ "name": "contentFrame" }],
          "anchor": { "containerName": "Member Search" },
          "candidates": [
            { "kind": "label", "text": "Member ID", "positional": true, "expect": "control" },
            { "kind": "structural", "css": "input[name='memberId']" }
          ],
          "evidence": {
            "role": "textbox",
            "tag": "input",
            "textSnippet": "Member Search panel; an identically labelled field exists in the Recent Terminal Activity panel, so the container anchor is load-bearing here"
          }
        }
      }
    },
    {
      "id": "submit_search",
      "intent": "Run the member search",
      "risk": "mutate_reversible",
      "action": {
        "kind": "click",
        "target": {
          "description": "Search button in the Member Search panel",
          "framePath": [{ "name": "contentFrame" }],
          "anchor": { "containerName": "Member Search" },
          "candidates": [
            { "kind": "role_name", "role": "button", "name": "Search", "exact": true },
            { "kind": "structural", "css": "input[name='go']" }
          ],
          "evidence": { "role": "button", "tag": "input", "accessibleName": "Search" }
        }
      }
    },
    {
      "id": "confirm_profile",
      "intent": "Confirm the member profile screen is showing before reading any values",
      "risk": "read",
      "action": {
        "kind": "assert",
        "condition": {
          "kind": "text_present",
          "text": "Member Profile",
          "framePath": [{ "name": "contentFrame" }]
        }
      }
    }
  ],

  "checkpoint": {
    "description": "The member profile and accounts panels are displayed for the requested member",
    "condition": {
      "kind": "all",
      "of": [
        { "kind": "text_present", "text": "Member Profile", "framePath": [{ "name": "contentFrame" }] },
        { "kind": "text_present", "text": "Accounts", "framePath": [{ "name": "contentFrame" }] },
        { "kind": "text_present", "text": "{{memberId}}", "framePath": [{ "name": "contentFrame" }] }
      ]
    }
  },

  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "The host has no member record for the supplied member number.",
      "when": {
        "kind": "text_present",
        "text": "No member record found",
        "framePath": [{ "name": "contentFrame" }]
      },
      "extract": []
    },
    {
      "code": "PERMISSION_DENIED",
      "description": "The signed-on operator is not entitled to view this member record.",
      "when": {
        "kind": "text_present",
        "text": "Entitlement check failed",
        "framePath": [{ "name": "contentFrame" }]
      },
      "extract": []
    },
    {
      "code": "INVALID_MEMBER_ID",
      "description": "The application rejected the member number as malformed.",
      "when": {
        "kind": "text_present",
        "text": "must be exactly 6 digits",
        "framePath": [{ "name": "contentFrame" }]
      },
      "extract": []
    }
  ],

  "recovery": [
    {
      "code": "ACCEPT_SYSTEM_DIALOG",
      "description": "The console raises an informational confirm() on some records; acknowledging it is safe and does not change any data.",
      "when": { "kind": "dialog_present" },
      "then": [{ "kind": "accept_dialog" }],
      "maxAttempts": 3
    }
  ],

  "failures": [
    {
      "code": "APP_ERROR",
      "description": "The servicing application returned its unhandled-exception screen",
      "when": {
        "kind": "text_present",
        "text": "An unexpected error has occurred",
        "framePath": [{ "name": "contentFrame" }]
      }
    },
    {
      "code": "SESSION_EXPIRED",
      "description": "The host closed the terminal session",
      "when": { "kind": "text_present", "text": "Your session has expired" }
    }
  ],

  "provenance": {
    "discoveredAt": "2026-08-13T00:00:00.000Z",
    "runId": "seed-reference",
    "goal": "Look up member 100001 and read their current savings balance",
    "model": "hand-authored reference",
    "humanEdits": [
      {
        "at": "2026-08-13T00:00:00.000Z",
        "by": "engineer",
        "note": "Seed artifact written by hand to develop and test the replay engine before the discovery loop existed. Superseded by the model-discovered artifact; kept as the schema's worked example."
      }
    ]
  }
}
