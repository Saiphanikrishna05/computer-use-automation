{
  "schemaVersion": "1.0.0",
  "tenantId": "cascade-cu",
  "tenantName": "Cascade Community Credit Union",
  "appliesTo": {
    "vendor": "meridian",
    "product": "servicing-console"
  },
  "bindings": {
    "baseUrl": "http://localhost:4174"
  },
  "frameAliases": {
    "navFrame": "menuFrame",
    "contentFrame": "mainFrame"
  },
  "extraRecovery": [
    {
      "code": "ACKNOWLEDGE_SYSTEM_NOTICE",
      "description": "This institution interrupts the first console load of each session with a scheduled-maintenance notice that must be acknowledged before the search screen appears. It is informational only.",
      "when": {
        "kind": "text_present",
        "text": "System Notice",
        "framePath": [
          {
            "name": "mainFrame"
          }
        ]
      },
      "then": [
        {
          "kind": "click",
          "target": {
            "description": "Acknowledge button on the system notice",
            "framePath": [
              {
                "name": "mainFrame"
              }
            ],
            "candidates": [
              {
                "kind": "role_name",
                "role": "button",
                "name": "Acknowledge",
                "exact": true
              }
            ],
            "evidence": {
              "role": "button",
              "tag": "input",
              "accessibleName": "Acknowledge"
            }
          }
        }
      ],
      "maxAttempts": 2
    }
  ],
  "notes": "Tenant-wide settings only: base URL, frame aliases and the extra login notice this institution shows. Step overrides live in cascade-cu.<capability>.json, because they are keyed by step id and therefore scoped to a recording."
}
