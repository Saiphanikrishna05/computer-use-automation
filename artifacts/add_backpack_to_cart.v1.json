{
  "schemaVersion": "1.0.0",
  "id": "add_backpack_to_cart",
  "version": 1,
  "title": "Add Sauce Labs Backpack to cart and reach Checkout Overview",
  "description": "Signs in to Swag Labs (saucedemo.com), adds the Sauce Labs Backpack ($29.99, the first item in the default Name A-Z product list) to the cart, opens the cart, starts checkout, fills the Checkout Information form (first name, last name, postal code), and continues to the Checkout: Overview page showing the line item, payment/shipping info and price total. It stops there deliberately: the order is NOT placed (the Finish button is never clicked), so this capability is non-committal and changes only the signed-in user's cart state. Returns no extracted values; success is the Checkout: Overview screen for the Sauce Labs Backpack.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "saucelabs",
      "product": "swag-labs",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "approved",
    "approvedBy": "sai",
    "approvedAt": "2026-08-14T23:25:56.176Z",
    "note": "Outcome wording quoted directly from the site."
  },
