{
  "schemaVersion": "1.0.0",
  "id": "mc_funds_transfer",
  "version": 1,
  "title": "Stage a member funds transfer up to the confirmation screen",
  "description": "Signs on to Meridian Core, searches a member by member number, opens the member record, opens the Funds Transfer form, fills From Share, To Share, Amount and Memo, and clicks Continue to reach the CONFIRM FUNDS TRANSFER review screen. It deliberately STOPS before Post Transfer, so no money moves and nothing is committed. Returns the confirmation summary: from-share and to-share ids with their current balances and the staged amount. Use this to validate/preview a transfer; a human must post it.",
  "target": {
    "surface": "web",
    "app": {
      "vendor": "cornerstone",
      "product": "meridian-core",
      "versionRange": "1.x"
    },
    "entryUrlTemplate": "{{baseUrl}}/"
  },
  "approval": {
    "state": "approved",
    "approvedBy": "operator",
    "approvedAt": "2026-08-27T01:51:32.108Z",
    "note": "reviewed and approved for unattended replay"
  },
  "inputs": [
    {
      "name": "operatorId",
      "type": "string",
      "description": "Servicing console operator user ID. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "pii",
      "injected": true
    },
    {
      "name": "operatorPassword",
      "type": "string",
      "description": "Servicing console operator password. Injected by the runtime credential store.",
      "required": true,
      "sensitivity": "secret",
      "injected": true
    },
    {
      "name": "branch",
      "type": "string",
      "description": "Branch the operator signs on against. Injected by the runtime.",
      "required": true,
      "sensitivity": "none",
      "injected": true
    },
    {
      "name": "memberNumber",
      "type": "string",
      "description": "Member number to search for and transfer within",
      "required": true,
      "sensitivity": "none",
      "pattern": "^\\d{6}$",
      "example": "102777",
      "injected": false
    },
    {
      "name": "fromShare",
      "type": "string",
      "description": "Share ID to debit, as shown in the From Share dropdown",
      "required": true,
      "sensitivity": "none",
      "example": "102777-MMKT-4",
      "injected": false
    },
    {
      "name": "toShare",
      "type": "string",
      "description": "Share ID to credit, as shown in the To Share dropdown",
      "required": true,
      "sensitivity": "none",
      "example": "102777-S0001",
      "injected": false
    },
    {
      "name": "amount",
      "type": "money",
      "description": "Transfer amount",
      "required": true,
      "sensitivity": "none",
      "example": "1.00",
      "injected": false
    },
    {
      "name": "memo",
      "type": "string",
      "description": "Memo text for the transfer",
      "required": true,
      "sensitivity": "none",
      "example": "demo transfer",
      "injected": false
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "description": "Host confirmation number for the posted transfer.",
      "required": true,
      "sensitivity": "none",
      "extract": {
        "target": {
          "description": "Confirmation value on the posted-transfer receipt",
          "framePath": [],
          "candidates": [
            {
              "kind": "label",
              "text": "Confirmation",
              "positional": true,
              "expect": "cell"
            }
          ],
          "evidence": {}
        },
        "source": "text",
        "transforms": [
          "collapse_whitespace"
        ]
      }
    }
  ],
